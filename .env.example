# ─── Credenciales NEUBOX (requeridas) ──────────────────────────
NEUBOX_API_KEY=tu_api_key
NEUBOX_API_SECRET=tu_api_secret
NEUBOX_USER_EMAIL=tu@email.com

# ─── Seguridad del MCP (requerida) ─────────────────────────────
# Token de acceso que deberás enviar en el header X-API-Key
MCP_API_KEY=genera_un_token_seguro_aqui

# ─── Lista blanca de IPs (opcional) ─────────────────────────────
# Formato: IPs separadas por coma, soporta CIDR
# Vacío = permitir todas las IPs (solo para desarrollo)
IP_WHITELIST=192.168.0.0/24,10.0.0.5

# ─── Rate Limiting (opcional) ───────────────────────────────────
# Máximo de peticiones por ventana de tiempo por IP
RATE_LIMIT_REQUESTS=60
# Tamaño de la ventana en segundos
RATE_LIMIT_WINDOW=60

# ─── Configuración del servidor (opcional) ─────────────────────
# Puerto del contenedor
MCP_PORT=8000
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO